{
  "name": "upi-mesh-backend",
  "version": "1.0.0",
  "description": "UPI Offline Mesh — Node.js/Express backend (MERN migration from Spring Boot)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testEnvironmentOptions": {},
    "globalSetup": null,
    "setupFiles": [
      "<rootDir>/tests/jestSetup.js"
    ]
  }
}
